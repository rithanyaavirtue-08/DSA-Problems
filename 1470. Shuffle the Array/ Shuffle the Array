class Solution {
    public int[] shuffle(int[] nums, int n) {
        int result[]=new int[nums.length];
        int j=0;
        for(int i=0;i<n;i++){
            int first=nums[i];
             result[j]=first;
            j++;
            int second=nums[n+i];

            result[j]=second;
            j++;

        }
        return result;
    }
}
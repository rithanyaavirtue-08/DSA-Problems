class Solution {
    public int finalValueAfterOperations(String[] operations) {
        int X=0;
        for(int i=0;i<operations.length;i++){
            if(operations[i].equals("--X")||operations[i].equals("X--")){
                X--;
            }
            else{
                X++;
            }
        }
        return X;
    }
}
// here we are checking for the operations
and if it is --X or X-- then we will decrease
the value of X by 1 and if it is ++X or X++
then we will increase the value of X by 1 and at the end we will return the final value of X
// Time complexity: O(n) where n is the length of the operations array

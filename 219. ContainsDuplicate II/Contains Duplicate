class Solution {
    public boolean containsNearbyDuplicate(int[] nums, int k) {

        HashMap<Integer, Integer> map = new HashMap<>();

        for(int i = 0; i < nums.length; i++){
            if(map.containsKey(nums[i])){
                if(i - map.get(nums[i]) <= k){
                    return true;
                }
            }
            map.put(nums[i], i);
        }

        return false;
    }
}////// here we are storing the index of the element in the map and if we find the same element again then we check if the difference of the current index and the index stored in the map is less than or equal to k then we return true else we update the index in the map to the current index
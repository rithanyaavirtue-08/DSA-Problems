class Solution {
    public int splitArray(int[] nums, int k) {
        int low=0;
        int high=0;
        for(int i=0;i<nums.length;i++){
            low=Math.max(low,nums[i]);
            high+=nums[i];
        }
        while(low<=high){
            int group=1;
            int currentCount=0;
            int mid=(low+high)/2;
            for(int i=0;i<nums.length;i++){
              if(currentCount+nums[i]<=mid){
                currentCount+=nums[i];
              }
              else{
                group++;
                currentCount=nums[i];
              }
            }
            if(group<=k){
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }
        return low;
    }
}
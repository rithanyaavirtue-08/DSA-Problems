class Solution {
    public int lengthOfLastWord(String s) {
        int result=0;
        for(int i=s.length()-1;i>=0;i--){
            if(s.charAt(i)==' '){
               if(result>0){
                break;
               }
            }
            else{
                result++;
            }

        }
        return result;
    }
}
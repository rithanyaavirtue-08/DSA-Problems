class Solution {
    public int totalFruit(int[] fruits) {
        int left=0;
        int max=0;
        HashMap<Integer,Integer> map=new HashMap<>();
        for(int right=0;right<fruits.length;right++){
           map.put(fruits[right],
           map.getOrDefault(fruits[right], 0) + 1);
           while(map.size()>2){
            map.put(fruits[left],map.get(fruits[left])- 1);
            if(map.get(fruits[left])==0){
                map.remove(fruits[left]);
            }
            left++;
           }
           max=Math.max(max,right-left+1);

        }

    return max;
    }
}
//same as longest consecutive ones but here we are using hash map to store the value of the fruit and its count and then we are checking if the size of the map is greater than 2 then we are removing the left pointer and then we are calculating the max length of the subarray which is the answer.
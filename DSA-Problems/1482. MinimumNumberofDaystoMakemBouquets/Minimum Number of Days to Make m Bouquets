class Solution {
    public int minDays(int[] bloomDay, int m, int k) {
        int low=bloomDay[0];
        int high=bloomDay[0];
        int result=0;

        if((long)m*k>bloomDay.length){
            return -1;
        }
        for(int i = 1; i < bloomDay.length; i++){
    low = Math.min(low, bloomDay[i]);
    high = Math.max(high, bloomDay[i]);
}
        while(low<=high){
            int count=0;
            int bouquet=0;
            int mid=(low+high)/2;
            for(int i=0;i<bloomDay.length;i++){
               if(bloomDay[i]<=mid){
                count++;
               }
               else{
                bouquet+=count/k;
                count=0;
               }
            }
            bouquet+=count/k;
            if(bouquet>=m){
                result=mid;
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }
        return result;
    }
}
class Solution {
    public String reverseWords(String s) {
             String sentence= "";
             String word="";
        for(int i=0;i<s.length();i++){
            if(s.charAt(i)!= ' '){
                word+=s.charAt(i);
            }

            if(s.charAt(i)==' '){
                 if (!word.equals("")){
             sentence=word+" "+sentence;
              word="";
            }
            }
        }
      sentence=word+" "+sentence;
        return sentence.trim();

    }
}
//example: "Hello World" => "World Hello"
word = "Hello"
sentence = "Hello "
word = "World" sentence =word +" "+sentence =>
sentence = "World Hello "